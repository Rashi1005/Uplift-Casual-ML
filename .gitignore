# ── Raw data ──────────────────────────────────────────────────────────────────
# Downloaded by `python src/prepare_data.py` or `python -m src.cli prepare-data`.
# Not committed — see data/MANIFEST.md for download instructions.
data/hillstrom.csv

# ── Processed splits ──────────────────────────────────────────────────────────
# Generated by the `preprocess` CLI command from data/hillstrom.csv.
# Exact files are reproducible with a fixed seed (default: 42).
# Not committed — regenerate with: python -m src.cli preprocess
data/processed/X_train.csv
data/processed/X_test.csv
data/processed/treatment_train.csv
data/processed/treatment_test.csv
data/processed/y_train.csv
data/processed/y_test.csv

# ── Trained models ────────────────────────────────────────────────────────────
# Generated by the `train-baseline` and `train-uplift` CLI commands.
# causal_forest_model.pkl is ~89 MB — too large for Git.
# Not committed — regenerate with: python -m src.cli train-baseline / train-uplift
data/processed/*.pkl

# ── Predictions and rankings ──────────────────────────────────────────────────
# Generated by the `train-baseline` and `train-uplift` CLI commands.
# Not committed — regenerate with the commands above.
data/processed/baseline_ranking.csv
data/processed/uplift_scores_combined.csv

# ── Evaluation results ────────────────────────────────────────────────────────
